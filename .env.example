# Nuformly backend — environment variables.
# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=4002

# MongoDB (Atlas or self-hosted) connection string
MONGO_URI=

# Groq AI provider — up to 5 keys, used in order as a rotation/
# fallback pool (see services/groq.service.js). At least one required.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

# Admin JWT signing secret. Use a long, random, high-entropy value —
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Comma-separated list of allowed browser origins for /api/admin/*
# (the admin panel's own deployed URL(s)). Not used for /bot/v1/* or
# other public routes, which stay open by design (embeddable widget).
ADMIN_ALLOWED_ORIGINS=

# Seed data for the initial platform Super Admin account (used by
# seeders/adminUser.seed.js — only read once, at first seed).
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# AES-256-GCM key for encrypting integration credentials at rest
# (webhook secrets, channel bot tokens — see utils/encryption.js).
# MUST be a 64-character hex string (32 bytes), e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
INTEGRATION_ENCRYPTION_KEY=

# Phase 15 realtime (Socket.IO) — optional. Reuses JWT_SECRET above
# for the /admin namespace, so no new required variable. This only
# caps how many simultaneous socket connections one IP may hold open
# at once (a basic connection-flood guard — see services/realtime/
# socket.server.js). Default if unset: 20.
SOCKET_MAX_CONNECTIONS_PER_IP=20
